  "trivia": [
    { "en": "Kishore Kumar was born Abhas Kumar Ganguly on 4 August 1929 in Khandwa, Madhya Pradesh.", "hi": "किशोर कुमार का असली नाम आभास कुमार गांगुली था। उनका जन्म 4 अगस्त 1929 को खंडवा (मध्य प्रदेश) में हुआ।" },
    { "en": "He won the Filmfare Best Male Playback Singer award 8 times — a record in that category.", "hi": "उन्होंने 8 बार फ़िल्मफ़ेयर सर्वश्रेष्ठ पार्श्व गायक का पुरस्कार जीता — इस श्रेणी में एक रिकॉर्ड।" },
    { "en": "His first Filmfare award came for \"Roop Tera Mastana\" from Aradhana (1969).", "hi": "उनका पहला फ़िल्मफ़ेयर पुरस्कार आराधना (1969) के गीत \"रूप तेरा मस्ताना\" के लिए मिला।" },
    { "en": "Aradhana (1969) turned Rajesh Khanna into a superstar and made Kishore his signature voice.", "hi": "आराधना (1969) ने राजेश खन्ना को सुपरस्टार बनाया और किशोर उनकी पहचान वाली आवाज़ बन गए।" },
    { "en": "\"Mere Sapnon Ki Rani\" was filmed alongside the Darjeeling toy train, with Rajesh Khanna in an open jeep.", "hi": "\"मेरे सपनों की रानी\" दार्जिलिंग की टॉय ट्रेन के साथ फ़िल्माया गया, राजेश खन्ना खुली जीप में थे।" },
    { "en": "Kishore's famous yodelling was inspired by recordings of Jimmie Rodgers and Tex Morton.", "hi": "किशोर की मशहूर योडलिंग जिमी रॉजर्स और टेक्स मॉर्टन की रिकॉर्डिंग से प्रेरित थी।" },
    { "en": "Chalti Ka Naam Gaadi (1958) starred all three Ganguly brothers — Ashok, Anoop and Kishore.", "hi": "चलती का नाम गाड़ी (1958) में तीनों गांगुली भाई — अशोक, अनूप और किशोर — एक साथ थे।" },
    { "en": "Kishore was also a director and composer — he made Door Gagan Ki Chhaon Mein (1964).", "hi": "किशोर निर्देशक और संगीतकार भी थे — उन्होंने 'दूर गगन की छाँव में' (1964) बनाई।" },
    { "en": "R.D. Burman ('Pancham') was the son of S.D. Burman — both composed many Kishore classics.", "hi": "आर.डी. बर्मन ('पंचम') एस.डी. बर्मन के बेटे थे — दोनों ने किशोर के कई क्लासिक गीत रचे।" },
    { "en": "\"O Mere Dil Ke Chain\" was written by Majrooh Sultanpuri; \"Zindagi Ke Safar Mein\" by Anand Bakshi.", "hi": "\"ओ मेरे दिल के चैन\" मजरूह सुल्तानपुरी ने लिखा; \"ज़िंदगी के सफ़र में\" आनंद बख्शी ने।" },
    { "en": "During the Emergency (1976), All India Radio stopped playing Kishore's songs for a period.", "hi": "आपातकाल (1976) के दौरान ऑल इंडिया रेडियो ने कुछ समय तक किशोर के गाने बजाना बंद कर दिया था।" },
    { "en": "Kishore Kumar passed away on 13 October 1987 in Bombay; he was cremated in Khandwa as he wished.", "hi": "किशोर कुमार का निधन 13 अक्टूबर 1987 को बंबई में हुआ; उनकी इच्छा के अनुसार खंडवा में अंतिम संस्कार हुआ।" }
  ]
}
